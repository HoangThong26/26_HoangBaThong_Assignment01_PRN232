@model IEnumerable<_26_HoangBaThong_Assignment01_FrontEnd.Models.NewsArticle>
@{ ViewData["Title"] = "Report"; }

<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
    <h2 class="mb-0 fw-bold">Statistics Report</h2>
</div>

<div class="card shadow-sm border-0 rounded-4 mb-4">
    <div class="card-body p-4 bg-light rounded-4">
        <form method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold text-muted">Start Date</label>
                <input type="date" name="startDate" class="form-control rounded-pill px-3" value="@ViewBag.StartDate" required />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold text-muted">End Date</label>
                <input type="date" name="endDate" class="form-control rounded-pill px-3" value="@ViewBag.EndDate" required />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary w-100 rounded-pill px-4 fw-bold">Generate Report</button>
            </div>
        </form>
    </div>
</div>

<div class="table-wrapper mt-0">
    <table class="table table-hover align-middle">
        <thead>
            <tr>
                <th>ID</th>
                <th>Title</th>
                <th>Headline</th>
                <th>Created Date</th>
                <th>Status</th>
            </tr>
        </thead>
        <tbody>
            @if(!Model.Any()) {
                <tr><td colspan="5" class="text-center text-muted py-4">No articles found in this period.</td></tr>
            }
            @foreach (var item in Model)
            {
                <tr>
                    <td class="fw-bold">@item.NewsArticleId</td>
                    <td class="fw-bold text-dark">@item.NewsTitle</td>
                    <td class="text-muted">@(item.Headline?.Length > 50 ? item.Headline.Substring(0, 50) + "..." : item.Headline)</td>
                    <td class="text-secondary"><i class="bi bi-calendar3"></i> @(item.CreatedDate?.ToString("MMM dd, yyyy"))</td>
                    <td>
                        @if (item.NewsStatus == true) { <span class="badge bg-success px-2 py-1 rounded-pill">Active</span> }
                        else { <span class="badge bg-danger px-2 py-1 rounded-pill">Inactive</span> }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
