@model IEnumerable<_26_HoangBaThong_Assignment01_FrontEnd.Models.SystemAccount>
@{ ViewData["Title"] = "Manage Accounts"; }
<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
    <h2 class="mb-0 fw-bold">System Accounts</h2>
    <button class="btn btn-primary btn-rounded shadow-sm" onclick="openModal()">+ Add Account</button>
</div>
@if (TempData["Error"] != null) { <div class="alert alert-danger rounded-3 shadow-sm">@TempData["Error"]</div> }
<div class="table-wrapper">
    <div class="row mb-3">
        <div class="col-md-5 ms-auto">
            <form method="get" class="d-flex gap-2">
                <input type="text" name="searchTerm" class="form-control rounded-pill" placeholder="Search by name or email..." value="@ViewBag.SearchTerm" />
                <button type="submit" class="btn btn-dark btn-rounded">Search</button>
            </form>
        </div>
    </div>
    <table class="table table-hover">
        <thead><tr><th>ID</th><th>Name</th><th>Email</th><th>Role</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td class="fw-bold">@item.AccountId</td><td>@item.AccountName</td><td class="text-muted">@item.AccountEmail</td>
                    <td>
                        @if (item.AccountRole == 1) { <span class="badge bg-primary px-3 py-2 rounded-pill">Staff</span> }
                        else if (item.AccountRole == 2) { <span class="badge bg-secondary px-3 py-2 rounded-pill">Lecturer</span> }
                        else { <span class="badge bg-dark px-3 py-2 rounded-pill">Admin</span> }
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary rounded-pill me-1 px-3" onclick="openModal('@item.AccountId', '@item.AccountName', '@item.AccountEmail', '@item.AccountRole')">Edit</button>
                        <form asp-action="Delete" asp-route-id="@item.AccountId" method="post" class="d-inline" onsubmit="return confirm('Delete this account?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="modal fade" tabindex="-1" id="accountModal"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form id="accountForm" method="post" asp-action="Create">
<div class="modal-header"><h5 class="modal-title" id="modalTitle">Add Account</h5><button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button></div>
<div class="modal-body">
<input type="hidden" name="AccountId" id="AccountId" value="0" />
<div class="mb-3"><label class="form-label text-muted fw-bold">Name</label><input type="text" name="AccountName" id="AccountName" class="form-control" required /></div>
<div class="mb-3"><label class="form-label text-muted fw-bold">Email</label><input type="email" name="AccountEmail" id="AccountEmail" class="form-control" required /></div>
<div class="mb-3"><label class="form-label text-muted fw-bold">Password</label><input type="password" name="AccountPassword" id="AccountPassword" class="form-control" autocomplete="new-password" /></div>
<div class="mb-3"><label class="form-label text-muted fw-bold">Role</label><select name="AccountRole" id="AccountRole" class="form-select"><option value="1">Staff</option><option value="2">Lecturer</option></select></div>
</div>
<div class="modal-footer border-top-0"><button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary rounded-pill px-4">Save</button></div>
</form></div></div></div>
<script>
function openModal(id, name, email, role) {
var modal = new bootstrap.Modal(document.getElementById('accountModal'));
var form = document.getElementById('accountForm');
if(id) { document.getElementById('modalTitle').innerText='Edit Account'; form.action='/SystemAccounts/Edit'; document.getElementById('AccountId').value=id; document.getElementById('AccountName').value=name; document.getElementById('AccountEmail').value=email; document.getElementById('AccountRole').value=role; }
else { document.getElementById('modalTitle').innerText='Add Account'; form.action='/SystemAccounts/Create'; document.getElementById('AccountId').value='0'; document.getElementById('AccountName').value=''; document.getElementById('AccountEmail').value=''; document.getElementById('AccountRole').value='1'; }
modal.show();
}
</script>
