@model IEnumerable<_26_HoangBaThong_Assignment01_FrontEnd.Models.SystemAccount>

@{ ViewData["Title"] = "Manage Accounts"; }

<h2>Manage Accounts (Admin)</h2>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">@TempData["Error"]</div>
}

<div class="d-flex justify-content-between mb-3">
    <button class="btn btn-success" onclick="openModal()">Add New Account</button>
    <form method="get" class="d-flex gap-2">
        <input type="text" name="searchTerm" class="form-control" placeholder="Search by name or email..." value="@ViewBag.SearchTerm" />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
</div>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Role</th>
            <th>Actions</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.AccountId</td>
                <td>@item.AccountName</td>
                <td>@item.AccountEmail</td>
                <td>@(item.AccountRole == 1 ? "Staff" : "Lecturer")</td>
                <td>
                    <button class="btn btn-sm btn-primary" onclick="openModal('@item.AccountId', '@item.AccountName', '@item.AccountEmail', '@item.AccountRole')">Edit</button>
                    <form asp-action="Delete" asp-route-id="@item.AccountId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this account?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>

<div class="modal" tabindex="-1" id="accountModal">
  <div class="modal-dialog">
    <div class="modal-content">
      <form id="accountForm" method="post" asp-action="Create">
      <div class="modal-header">
        <h5 class="modal-title" id="modalTitle">Add Account</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
      </div>
      <div class="modal-body">
        <input type="hidden" name="AccountId" id="AccountId" value="0" />
        <div class="mb-3">
            <label>Name</label>
            <input type="text" name="AccountName" id="AccountName" class="form-control" required />
        </div>
        <div class="mb-3">
            <label>Email</label>
            <input type="email" name="AccountEmail" id="AccountEmail" class="form-control" required />
        </div>
        <div class="mb-3">
            <label>Password</label>
            <input type="password" name="AccountPassword" id="AccountPassword" class="form-control" autocomplete="new-password" />
        </div>
        <div class="mb-3">
            <label>Role</label>
            <select name="AccountRole" id="AccountRole" class="form-control">
                <option value="1">Staff</option>
                <option value="2">Lecturer</option>
            </select>
        </div>
      </div>
      <div class="modal-footer">
        <button type="submit" class="btn btn-primary">Save</button>
      </div>
      </form>
    </div>
  </div>
</div>

<script>
    function openModal(id, name, email, role) {
        var modal = new bootstrap.Modal(document.getElementById('accountModal'));
        var form = document.getElementById('accountForm');
        
        if (id) {
            document.getElementById('modalTitle').innerText = 'Edit Account';
            form.action = '/SystemAccounts/Edit';
            document.getElementById('AccountId').value = id;
            document.getElementById('AccountName').value = name;
            document.getElementById('AccountEmail').value = email;
            document.getElementById('AccountRole').value = role;
        } else {
            document.getElementById('modalTitle').innerText = 'Add Account';
            form.action = '/SystemAccounts/Create';
            document.getElementById('AccountId').value = '0';
            document.getElementById('AccountName').value = '';
            document.getElementById('AccountEmail').value = '';
            document.getElementById('AccountRole').value = '1';
        }
        modal.show();
    }
</script>
