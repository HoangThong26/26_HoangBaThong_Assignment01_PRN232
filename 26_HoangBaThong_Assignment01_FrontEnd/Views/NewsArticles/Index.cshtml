@model IEnumerable<_26_HoangBaThong_Assignment01_FrontEnd.Models.NewsArticle>
@{ ViewData["Title"] = "Manage News Articles"; }
<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
    <h2 class="mb-0 fw-bold">News Articles</h2>
    <button class="btn btn-primary btn-rounded shadow-sm" onclick="openModal()">+ Add Article</button>
</div>
@if (TempData["Error"] != null) { <div class="alert alert-danger rounded-3 shadow-sm">@TempData["Error"]</div> }
<div class="table-wrapper">
    <div class="row mb-3">
        <div class="col-md-5 ms-auto">
            <form method="get" class="d-flex gap-2">
                <input type="text" name="searchTerm" class="form-control rounded-pill" placeholder="Search by title..." value="@ViewBag.SearchTerm" />
                <button type="submit" class="btn btn-dark btn-rounded">Search</button>
            </form>
        </div>
    </div>
    <table class="table table-hover align-middle">
        <thead><tr><th>ID</th><th>Title</th><th>Category</th><th>Tags</th><th>Status</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td class="fw-bold">@item.NewsArticleId</td>
                    <td>
                        <div class="fw-bold text-dark">@item.NewsTitle</div>
                        <div class="small text-muted">@item.Headline</div>
                    </td>
                    <td><span class="badge bg-secondary px-2 py-1 rounded-pill">@(item.Category?.CategoryName)</span></td>
                    <td>
                        @if(item.Tags != null) {
                            @foreach(var t in item.Tags) {
                                <span class="badge bg-info text-dark me-1">@t.TagName</span>
                            }
                        }
                    </td>
                    <td>
                        @if (item.NewsStatus == true) { <span class="badge bg-success px-2 py-1 rounded-pill">Active</span> }
                        else { <span class="badge bg-danger px-2 py-1 rounded-pill">Inactive</span> }
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary rounded-pill me-1 px-3" onclick="openModal('@item.NewsArticleId', '@(item.NewsTitle?.Replace("'", "\\'"))', '@(item.Headline?.Replace("'", "\\'"))', '@(item.NewsContent?.Replace("'", "\\'"))', '@(item.NewsSource?.Replace("'", "\\'"))', '@item.CategoryId', '@item.NewsStatus', [@string.Join(",", item.Tags?.Select(t => t.TagId) ?? new int[0])])">Edit</button>
                        <form asp-action="Delete" asp-route-id="@item.NewsArticleId" method="post" class="d-inline" onsubmit="return confirm('Delete this article?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="modal fade" tabindex="-1" id="newsModal"><div class="modal-dialog modal-lg modal-dialog-centered"><div class="modal-content"><form id="newsForm" method="post" asp-action="Create">
<div class="modal-header"><h5 class="modal-title" id="modalTitle">Add Article</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
<div class="modal-body">
<div class="row">
    <input type="hidden" name="NewsArticleId" id="NewsArticleId" />
    <div class="col-md-12 mb-3"><label class="form-label text-muted fw-bold">Category</label><select name="CategoryId" id="CategoryId" class="form-select">
        @if(ViewBag.Categories != null) {
            @foreach(var c in ViewBag.Categories){<option value="@c.CategoryId">@c.CategoryName</option>}
        }
    </select></div>
</div>
<div class="mb-3"><label class="form-label text-muted fw-bold">Title</label><input type="text" name="NewsTitle" id="NewsTitle" class="form-control" required /></div>
<div class="mb-3"><label class="form-label text-muted fw-bold">Headline</label><input type="text" name="Headline" id="Headline" class="form-control" required /></div>
<div class="mb-3"><label class="form-label text-muted fw-bold">Content</label><textarea name="NewsContent" id="NewsContent" class="form-control" rows="5"></textarea></div>
<div class="row">
    <div class="col-md-8 mb-3"><label class="form-label text-muted fw-bold">Tags (Hold Ctrl to select multiple)</label>
        <select name="TagIds" id="TagIds" class="form-select" multiple style="height: 100px;">
            @if(ViewBag.Tags != null) {
                @foreach(var t in ViewBag.Tags) { <option value="@t.TagId">@t.TagName</option> }
            }
        </select>
    </div>
    <div class="col-md-4 mb-3">
        <label class="form-label text-muted fw-bold">Source</label><input type="text" name="NewsSource" id="NewsSource" class="form-control mb-2" />
        <label class="form-label text-muted fw-bold">Status</label><select name="NewsStatus" id="NewsStatus" class="form-select"><option value="true">Active</option><option value="false">Inactive</option></select>
    </div>
</div>
</div>
<div class="modal-footer border-top-0"><button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary rounded-pill px-4">Save</button></div>
</form></div></div></div>
<script>
function openModal(id, title, head, content, src, cat, stat, tagIds) {
var modal = new bootstrap.Modal(document.getElementById('newsModal'));
var form = document.getElementById('newsForm');
var tagSelect = document.getElementById('TagIds');
for(var i=0; i<tagSelect.options.length; i++) { tagSelect.options[i].selected = false; }
if(id) { document.getElementById('modalTitle').innerText='Edit Article'; form.action='/NewsArticles/Edit'; document.getElementById('NewsArticleId').value=id; document.getElementById('NewsArticleId').readOnly=true; document.getElementById('NewsTitle').value=title; document.getElementById('Headline').value=head; document.getElementById('NewsContent').value=content; document.getElementById('NewsSource').value=src; document.getElementById('CategoryId').value=cat; document.getElementById('NewsStatus').value=stat;
if(tagIds) { for(var i=0; i<tagSelect.options.length; i++) { if(tagIds.includes(parseInt(tagSelect.options[i].value))) { tagSelect.options[i].selected = true; } } }
}
else { 
    document.getElementById('modalTitle').innerText='Add Article'; 
    form.action='/NewsArticles/Create'; 
    // Sinh số ngẫu nhiên từ 1000 đến 9999 cho giống format số
    document.getElementById('NewsArticleId').value = Math.floor(Math.random() * 9000 + 1000).toString(); 
    document.getElementById('NewsArticleId').readOnly=true; 
    document.getElementById('NewsTitle').value=''; 
    document.getElementById('Headline').value=''; 
    document.getElementById('NewsContent').value=''; 
    document.getElementById('NewsSource').value=''; 
    document.getElementById('NewsStatus').value='true'; 
}
modal.show();
}
</script>
