@model IEnumerable<_26_HoangBaThong_Assignment01_FrontEnd.Models.NewsArticle>
@{ ViewData["Title"] = "Home Page"; }
<div class="text-center mb-5">
    <h1 class="display-4">Welcome to FUNewsManagement</h1>
    <p>Read the latest news articles from our system.</p>
</div>
<div class="row">
    @foreach(var item in Model) {
        <div class="col-md-4 mb-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <h5 class="card-title">@item.NewsTitle</h5>
                    <h6 class="card-subtitle mb-2 text-muted">@item.Headline</h6>
                    <p class="card-text">@(item.NewsContent?.Length > 100 ? item.NewsContent.Substring(0, 100) + "..." : item.NewsContent)</p>
                </div>
                <div class="card-footer bg-white border-top-0">
                    <small class="text-muted">By @(item.CreatedBy?.AccountName) in @(item.Category?.CategoryName)</small><br/>
                    <small class="text-muted">@item.CreatedDate?.ToString("MMM dd, yyyy")</small>
                </div>
            </div>
        </div>
    }
</div>
