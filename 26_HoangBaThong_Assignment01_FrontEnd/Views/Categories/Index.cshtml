@model IEnumerable<_26_HoangBaThong_Assignment01_FrontEnd.Models.Category>
@{ ViewData["Title"] = "Manage Categories"; }
<div class="d-flex justify-content-between align-items-center mt-3 mb-4">
    <h2 class="mb-0 fw-bold">Categories</h2>
    <button class="btn btn-primary btn-rounded shadow-sm" onclick="openModal()">+ Add Category</button>
</div>
@if (TempData["Error"] != null) { <div class="alert alert-danger rounded-3 shadow-sm">@TempData["Error"]</div> }
<div class="table-wrapper">
    <div class="row mb-3">
        <div class="col-md-5 ms-auto">
            <form method="get" class="d-flex gap-2">
                <input type="text" name="searchTerm" class="form-control rounded-pill" placeholder="Search categories..." value="@ViewBag.SearchTerm" />
                <button type="submit" class="btn btn-dark btn-rounded">Search</button>
            </form>
        </div>
    </div>
    <table class="table table-hover">
        <thead><tr><th>ID</th><th>Name</th><th>Description</th><th class="text-end">Actions</th></tr></thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td class="fw-bold">@item.CategoryId</td><td>@item.CategoryName</td><td class="text-muted">@item.CategoryDesciption</td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-primary rounded-pill me-1 px-3" onclick="openModal('@item.CategoryId', '@item.CategoryName', '@item.CategoryDesciption', '@item.ParentCategoryId', '@item.IsActive')">Edit</button>
                        <form asp-action="Delete" asp-route-id="@item.CategoryId" method="post" class="d-inline" onsubmit="return confirm('Delete this category?');">
                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Delete</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
<div class="modal fade" tabindex="-1" id="catModal"><div class="modal-dialog modal-dialog-centered"><div class="modal-content"><form id="catForm" method="post" asp-action="Create">
<div class="modal-header"><h5 class="modal-title" id="modalTitle">Add Category</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
<div class="modal-body">
<input type="hidden" name="CategoryId" id="CategoryId" value="0" />
<div class="mb-3"><label class="form-label text-muted fw-bold">Name</label><input type="text" name="CategoryName" id="CategoryName" class="form-control" required /></div>
<div class="mb-3"><label class="form-label text-muted fw-bold">Description</label><input type="text" name="CategoryDesciption" id="CategoryDesciption" class="form-control" required /></div>
<input type="hidden" name="IsActive" id="IsActive" value="true" />
</div>
<div class="modal-footer border-top-0"><button type="button" class="btn btn-light rounded-pill" data-bs-dismiss="modal">Cancel</button><button type="submit" class="btn btn-primary rounded-pill px-4">Save</button></div>
</form></div></div></div>
<script>
function openModal(id, name, desc, parent, isActive) {
var modal = new bootstrap.Modal(document.getElementById('catModal'));
var form = document.getElementById('catForm');
if(id) { document.getElementById('modalTitle').innerText='Edit Category'; form.action='/Categories/Edit'; document.getElementById('CategoryId').value=id; document.getElementById('CategoryName').value=name; document.getElementById('CategoryDesciption').value=desc; document.getElementById('IsActive').value=isActive; }
else { 
    document.getElementById('modalTitle').innerText='Add Category'; 
    form.action='/Categories/Create'; 
    document.getElementById('CategoryId').value = '0'; 
    document.getElementById('CategoryName').value=''; 
    document.getElementById('CategoryDesciption').value=''; 
    document.getElementById('IsActive').value='true'; 
}
modal.show();
}
</script>
