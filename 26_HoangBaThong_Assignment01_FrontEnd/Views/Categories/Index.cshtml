@model IEnumerable<_26_HoangBaThong_Assignment01_FrontEnd.Models.Category>
@{ ViewData["Title"] = "Manage Categories"; }
<h2>Manage Categories (Staff)</h2>
@if (TempData["Error"] != null) { <div class="alert alert-danger">@TempData["Error"]</div> }
<div class="d-flex justify-content-between mb-3">
    <button class="btn btn-success" onclick="openModal()">Add New Category</button>
    <form method="get" class="d-flex gap-2">
        <input type="text" name="searchTerm" class="form-control" placeholder="Search by name..." value="@ViewBag.SearchTerm" />
        <button type="submit" class="btn btn-primary">Search</button>
    </form>
</div>
<table class="table table-bordered">
    <thead><tr><th>ID</th><th>Name</th><th>Description</th><th>Actions</th></tr></thead>
    <tbody>
        @foreach (var item in Model) {
            <tr>
                <td>@item.CategoryId</td><td>@item.CategoryName</td><td>@item.CategoryDesciption</td>
                <td>
                    <button class="btn btn-sm btn-primary" onclick="openModal('@item.CategoryId', '@item.CategoryName', '@item.CategoryDesciption', '@item.ParentCategoryId', '@item.IsActive')">Edit</button>
                    <form asp-action="Delete" asp-route-id="@item.CategoryId" method="post" class="d-inline" onsubmit="return confirm('Are you sure you want to delete this category?');">
                        <button type="submit" class="btn btn-sm btn-danger">Delete</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>
<div class="modal" tabindex="-1" id="catModal"><div class="modal-dialog"><div class="modal-content"><form id="catForm" method="post" asp-action="Create">
<div class="modal-header"><h5 class="modal-title" id="modalTitle">Add Category</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
<div class="modal-body">
<input type="hidden" name="CategoryId" id="CategoryId" value="0" />
<div class="mb-3"><label>Name</label><input type="text" name="CategoryName" id="CategoryName" class="form-control" required /></div>
<div class="mb-3"><label>Description</label><input type="text" name="CategoryDesciption" id="CategoryDesciption" class="form-control" required /></div>
<input type="hidden" name="IsActive" id="IsActive" value="true" />
</div>
<div class="modal-footer"><button type="submit" class="btn btn-primary">Save</button></div>
</form></div></div></div>
<script>
function openModal(id, name, desc, parent, isActive) {
var modal = new bootstrap.Modal(document.getElementById('catModal'));
var form = document.getElementById('catForm');
if(id) { document.getElementById('modalTitle').innerText='Edit Category'; form.action='/Categories/Edit'; document.getElementById('CategoryId').value=id; document.getElementById('CategoryName').value=name; document.getElementById('CategoryDesciption').value=desc; document.getElementById('IsActive').value=isActive; }
else { document.getElementById('modalTitle').innerText='Add Category'; form.action='/Categories/Create'; document.getElementById('CategoryId').value='0'; document.getElementById('CategoryName').value=''; document.getElementById('CategoryDesciption').value=''; document.getElementById('IsActive').value='true'; }
modal.show();
}
</script>
